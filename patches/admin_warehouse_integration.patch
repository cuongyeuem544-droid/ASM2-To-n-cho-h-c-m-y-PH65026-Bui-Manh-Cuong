+                              rejected_quantity: rej,
+                              restock_quantity: item.restock_destination === 'SELLABLE_STOCK' ? val : 0,
+                            })
+                          }}
+                          style={{ width: '100%', padding: '6px 8px', borderRadius: '6px', border: '1px solid #cbd5e1', fontSize: '12.5px' }}
+                        />
+                      </div>
+
+                      <div>
+                        <label style={{ display: 'block', fontSize: '11.5px', fontWeight: 600, color: '#475569', marginBottom: '4px' }}>
+                          SL loại bỏ
+                        </label>
+                        <input
+                          type="number"
+                          min={0}
+                          max={item.requested_quantity}
+                          value={item.rejected_quantity}
+                          onChange={(e) => {
+                            const rej = Math.max(0, Math.min(item.requested_quantity, Number(e.target.value)))
+                            const acc = Math.max(0, item.requested_quantity - rej)
+                            updateInspectItem(idx, {
+                              rejected_quantity: rej,
+                              accepted_quantity: acc,
+                              restock_quantity: item.restock_destination === 'SELLABLE_STOCK' ? acc : 0,
+                            })
+                          }}
+                          style={{ width: '100%', padding: '6px 8px', borderRadius: '6px', border: '1px solid #cbd5e1', fontSize: '12.5px' }}
+                        />
+                      </div>
+
+                      <div>
+                        <label style={{ display: 'block', fontSize: '11.5px', fontWeight: 600, color: '#475569', marginBottom: '4px' }}>
+                          SL nhập kho bán
+                        </label>
+                        <input
+                          type="number"
+                          min={0}
+                          max={item.accepted_quantity}
+                          disabled={item.restock_destination !== 'SELLABLE_STOCK'}
+                          value={item.restock_destination === 'SELLABLE_STOCK' ? item.restock_quantity : 0}
+                          onChange={(e) => {
+                            const rVal = Math.max(0, Math.min(item.accepted_quantity, Number(e.target.value)))
+                            updateInspectItem(idx, { restock_quantity: rVal })
+                          }}
+                          style={{
+                            width: '100%',
+                            padding: '6px 8px',
+                            borderRadius: '6px',
+                            border: '1px solid #cbd5e1',
+                            fontSize: '12.5px',
+                            background: item.restock_destination === 'SELLABLE_STOCK' ? '#fff' : '#f1f5f9',
+                          }}
+                        />
+                      </div>
+                    </div>
+
+                    <div>
+                      <input
+                        type="text"
+                        placeholder="Ghi chú chi tiết cho sản phẩm này..."
+                        value={item.notes}
+                        onChange={(e) => updateInspectItem(idx, { notes: e.target.value })}
+                        style={{ width: '100%', padding: '6px 8px', borderRadius: '6px', border: '1px solid #cbd5e1', fontSize: '12px' }}
+                      />
+                    </div>
+                  </div>
+                ))}
+              </div>
+
+              <div>
+                <label style={{ display: 'block', fontSize: '12px', fontWeight: 600, color: '#334155', marginBottom: '4px' }}>
+                  Biên bản ghi chú tổng quát của Dược sĩ
+                </label>
+                <textarea
+                  rows={2}
+                  value={pharmacistNotes}
+                  onChange={(e) => setPharmacistNotes(e.target.value)}
+                  style={{ width: '100%', padding: '8px 10px', borderRadius: '6px', border: '1px solid #cbd5e1', fontSize: '13px' }}
+                  required
+                />
+              </div>
+
+              <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '6px' }}>
+                <button
+                  type="button"
+                  className="button button-secondary"
+                  onClick={() => setInspectModalOpen(false)}
+                  style={{ fontSize: '13px' }}
+                >
+                  Hủy bỏ
+                </button>
+                <button
+                  type="submit"
+                  disabled={inspectSubmitting}
+                  className="button button-primary"
+                  style={{ fontSize: '13px', background: '#7e22ce' }}
+                >
+                  {inspectSubmitting ? 'Đang lưu...' : 'Xác nhận kiểm định & Phân luồng'}
+                </button>
+              </div>
+            </form>
+          </div>
+        </div>
+      )}
     </div>
   )
 }
