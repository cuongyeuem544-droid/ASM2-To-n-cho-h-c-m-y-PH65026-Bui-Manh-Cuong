# ==============================================================================
# PHARMATRUST / H4CARE - UNIFIED ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Sao chép tệp này thành .env ở thư mục gốc để cấu hình chạy hệ thống.

APP_NAME="PharmaTrust Data Hub"
APP_ENV=development
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-value-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Chế độ phát triển cục bộ (Local Development - Mặc định SQLite):
DATABASE_URL=sqlite:///./pharmatrust.db

# Chế độ triển khai Docker / Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://pharmatrust:pharmatrust@localhost:5432/pharmatrust

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# CORS & Networking
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
PUBLIC_API_MIN_SCORE=85

# File Storage
STORAGE_ROOT=storage
MAX_UPLOAD_MB=20
ALLOW_PUBLIC_URL_IMPORT=false

# ------------------------------------------------------------------------------
# AI & Extraction Service / Pharmacist Chatbot
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=25000

# ------------------------------------------------------------------------------
# Crawler & Automation (Mặc định tắt trong luồng chính)
# ------------------------------------------------------------------------------
AUTO_CRAWL_ENABLED=false
AUTO_CRAWL_INTERVAL_HOURS=6
PHARMACITY_CRAWL_ENABLED=false
LONG_CHAU_CRAWL_ENABLED=false
DEFAULT_PUBLISH_MODE=MANUAL_REVIEW
PUBLIC_BROWSER_FALLBACK_ENABLED=true
CATEGORY_AI_THRESHOLD=0.85
JOB_LEASE_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------------------------
# Alerts & Notifications
# ------------------------------------------------------------------------------
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Bản Đồ & Định Vị (VIETMAP & Google Maps Platform)
# ------------------------------------------------------------------------------
# VIETMAP Reverse Geocoding Services Key (Lấy vị trí của tôi & Reverse Geocoding v4)
VIETMAP_SERVICES_KEY=
VIETMAP_API_KEY=

# Google Maps Platform (Places Autocomplete, Place Details, Geocoding)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ROUTES_ENABLED=false

# ------------------------------------------------------------------------------
# MoMo Sandbox Payment Gateway
# ------------------------------------------------------------------------------
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX0huAHevg3hkVo
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/checkout/result
MOMO_IPN_URL=http://localhost:8000/api/v1/payments/momo/webhook

# ------------------------------------------------------------------------------
# Gmail SMTP Service (Gửi email thông báo / đơn hàng)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="PharmaTrust H4CARE"
SMTP_FROM_EMAIL=support@pharmatrust.vn
SMTP_TLS=true
SMTP_SSL=false
SMTP_ENABLED=true
