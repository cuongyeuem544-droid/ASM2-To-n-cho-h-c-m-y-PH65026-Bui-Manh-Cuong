# Database configuration for Storefront
DATABASE_URL="file:./dev.db"

# ==============================================================================
# H4CARE AI PHARMACIST CHATBOT & OCR EXTRACTION CONFIGURATION
# ==============================================================================
# Lựa chọn AI Provider:
# - "gemini" : Sử dụng Google Gemini API (Khuyên dùng: tốc độ cao, tiếng Việt tốt, chi phí tối ưu)
# - "openai" : Sử dụng OpenAI API (gpt-4o-mini, gpt-4o)
# - "ollama" : Sử dụng mô hình mã nguồn mở nội bộ (qwen2.5:3b, llama3)
# - "mock"   : Sử dụng Động cơ Tri thức & Phân luồng Dược khoa H4CARE Fallback (không cần API key ngoài)
AI_PROVIDER="gemini"

# API Keys (Bảo mật nghiêm ngặt ở Server, tuyệt đối không lộ ở Client):
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_API_KEY=""

# Model & Endpoint Configuration:
# - Gemini : "gemini-1.5-flash" hoặc "gemini-2.0-flash"
# - OpenAI : "gpt-4o-mini"
# - Ollama : "qwen2.5:3b"
AI_MODEL="gemini-1.5-flash"
AI_BASE_URL="https://api.openai.com/v1"
AI_TIMEOUT_MS=25000
MAX_OCR_TEXT_LENGTH=15000
